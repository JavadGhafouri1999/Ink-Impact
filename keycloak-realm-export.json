{
  "id" :                   "blog-realm",
  "realm" :                "blog-realm",
  "enabled" :              true,
  "displayName" :          "Blog Platform Realm",
  "accessTokenLifespan" :  900,
  "refreshTokenLifespan" : 86400,
  "roles" :                {
	"realm" : [
	  {
		"name" :        "Owner",
		"description" : "Full system control"
	  },
	  {
		"name" :        "admin",
		"description" : "Administrative user"
	  },
	  {
		"name" :        "user",
		"description" : "Regular authenticated user"
	  },
	  {
		"name" :        "special_user",
		"description" : "Special/premium user"
	  },
	  {
		"name" :        "Author",
		"description" : "Can create and edit own posts"
	  }
	]
  },
  "clients" :              [
	{
	  "clientId" :                  "blog-backend",
	  "name" :                      "Blog Backend",
	  "enabled" :                   true,
	  "publicClient" :              false,
	  "secret" :                    "REPLACE_WITH_STRONG_SECRET",
	  "protocol" :                  "openid-connect",
	  "directAccessGrantsEnabled" : true,
	  "serviceAccountsEnabled" :    true,
	  "redirectUris" :              [
		"http://localhost:4004/*"
	  ],
	  "webOrigins" :                [
		"http://localhost:4004"
	  ],
	  "attributes" :                {
		"access.token.lifespan" :                "900",
		"client_credentials.use_refresh_token" : "false"
	  },
	  "protocolMappers" :           [
		{
		  "name" :            "user-id-mapper",
		  "protocol" :        "openid-connect",
		  "protocolMapper" :  "oidc-usermodel-property-mapper",
		  "consentRequired" : false,
		  "config" :          {
			"user.attribute" :       "id",
			"claim.name" :           "user_id",
			"jsonType.label" :       "String",
			"id.token.claim" :       "true",
			"access.token.claim" :   "true",
			"userinfo.token.claim" : "true"
		  }
		},
		{
		  "name" :            "realm-roles-mapper",
		  "protocol" :        "openid-connect",
		  "protocolMapper" :  "oidc-usermodel-realm-role-mapper",
		  "consentRequired" : false,
		  "config" :          {
			"multivalued" :        "true",
			"claim.name" :         "roles",
			"jsonType.label" :     "String",
			"access.token.claim" : "true",
			"id.token.claim" :     "true"
		  }
		}
	  ]
	}
  ],
  "users" :                [
	{
	  "username" :    "owner",
	  "enabled" :     true,
	  "email" :       "owner@blog.com",
	  "firstName" :   "System",
	  "lastName" :    "Owner",
	  "credentials" : [
		{
		  "type" :      "password",
		  "value" :     "Owner@123",
		  "temporary" : false
		}
	  ],
	  "realmRoles" :  [
		"Owner",
		"admin",
		"Author"
	  ]
	},
	{
	  "username" :    "author1",
	  "enabled" :     true,
	  "email" :       "author@blog.com",
	  "firstName" :   "Regular",
	  "lastName" :    "Author",
	  "credentials" : [
		{
		  "type" :      "password",
		  "value" :     "Author@123",
		  "temporary" : false
		}
	  ],
	  "realmRoles" :  [
		"Author",
		"user"
	  ]
	},
	{
	  "username" :    "user1",
	  "enabled" :     true,
	  "email" :       "user@blog.com",
	  "firstName" :   "Normal",
	  "lastName" :    "User",
	  "credentials" : [
		{
		  "type" :      "password",
		  "value" :     "User@123",
		  "temporary" : false
		}
	  ],
	  "realmRoles" :  [
		"user"
	  ]
	}
  ]
}
